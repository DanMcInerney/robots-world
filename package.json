{
  "name": "robots-world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small, controller-neutral robotics simulation and contract test host.",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./devices/tf-luna": "./src/devices/tf-luna.ts",
    "./devices/fiducial-camera": "./src/devices/fiducial-camera.ts",
    "./perception/fiducial": "./src/perception/fiducial.ts",
    "./protocols/tf-luna": "./src/protocols/tf-luna.ts"
  },
  "scripts": {
    "dev": "node server.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "experiment": "node experiments/run.ts",
    "compare": "node experiments/compare.ts",
    "agent": "node controllers/run.ts",
    "mavlink": "node integrations/mavlink-cli.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "^8.17.1",
    "js-aruco2": "2.0.0",
    "node-mavlink": "2.3.0",
    "three": "0.186.0",
    "vite": "8.3.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.273"
  },
  "overrides": {
    "xml2js": "0.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.183.0",
    "typescript": "~5.9.3"
  }
}
